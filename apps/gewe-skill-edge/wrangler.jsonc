{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gewe-skill-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "EXPECTED_APP_ID": "replace-with-your-gewe-app-id",
    "EXPECTED_WXID": "replace-with-your-wechat-wxid",
    "GEWE_API_BASE": "http://api.geweapi.com",
    "D1_MESSAGE_TTL_DAYS": "30",
    "RAW_EVENT_TTL_DAYS": "30",
    "R2_ATTACHMENT_TTL_DAYS": "7",
    "MAX_ATTACHMENT_BYTES": "209715200",
    "IMAGE_DOWNLOAD_TYPE": "2"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gewe_skill_edge",
      "database_id": "replace-with-your-d1-database-id",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "gewe-skill-edge"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ATTACHMENT_QUEUE",
        "queue": "gewe-skill-attachments"
      }
    ],
    "consumers": [
      {
        "queue": "gewe-skill-attachments",
        "max_batch_size": 1,
        "max_batch_timeout": 30,
        "max_concurrency": 2
      }
    ]
  },
  "triggers": {
    "crons": ["37 18 * * *"]
  },
  "secrets": {
    "required": ["GEWE_TOKEN", "CALLBACK_SECRET", "ADMIN_API_KEY"]
  }
}
