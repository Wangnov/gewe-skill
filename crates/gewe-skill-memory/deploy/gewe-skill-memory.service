[Unit]
Description=gewe-skill memory service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gewe-skill
Group=gewe-skill
WorkingDirectory=/opt/gewe-skill-memory
EnvironmentFile=/opt/gewe-skill-memory/config/gewe-skill-memory.env
ExecStart=/opt/gewe-skill-memory/bin/gewe-skill-memory
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gewe-skill-memory/data

[Install]
WantedBy=multi-user.target
