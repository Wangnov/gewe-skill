GEWE_SKILL_DATABASE_URL=sqlite:/opt/gewe-skill-memory/data/gewe-skill-memory.sqlite?mode=rwc
GEWE_SKILL_LISTEN=127.0.0.1:8788
GEWE_SKILL_WRITE_TOKEN=replace-with-random-write-token
GEWE_SKILL_READ_TOKEN=replace-with-random-read-token
RUST_LOG=info,tower_http=info
GEWE_SKILL_BASE_URL=http://127.0.0.1:8788
GEWE_SKILL_EDGE_URL=https://gewe-agent.wangnov-ai.com
GEWE_SKILL_EDGE_ADMIN_TOKEN=replace-with-edge-admin-token
GEWE_SKILL_SYNC_CURSOR_FILE=/opt/gewe-skill-memory/data/edge-sync.cursor
GEWE_SKILL_ATTACHMENT_DIR=/opt/gewe-skill-memory/data/attachments
GEWE_SKILL_ATTACHMENT_CURSOR_FILE=/opt/gewe-skill-memory/data/edge-attachment-sync.cursor
GEWE_SKILL_ATTACHMENT_REPAIR_ASSET_TYPE=all
GEWE_SKILL_ATTACHMENT_REPAIR_BACKFILL_LIMIT=100
GEWE_SKILL_ATTACHMENT_REPAIR_SYNC_LIMIT=50
GEWE_SKILL_ATTACHMENT_REPAIR_SETTLE_MS=2000
GEWE_SKILL_CHATROOM_MEMBER_EVENT_CURSOR_FILE=/opt/gewe-skill-memory/data/edge-chatroom-member-events.cursor
GEWE_SKILL_CHATROOM_SYSTEM_EVENT_CURSOR_FILE=/opt/gewe-skill-memory/data/edge-chatroom-system-events.cursor
GEWE_SKILL_GEWE_BASE_URL=http://api.geweapi.com
GEWE_SKILL_GEWE_APP_ID=replace-with-gewe-app-id
GEWE_SKILL_GEWE_TOKEN=replace-with-gewe-token
GEWE_SKILL_IDENTITY_STALE_AFTER_DAYS=1

# Voice ASR. The default provider is codex-asr, which serves an OpenAI-compatible
# /v1/audio/transcriptions endpoint and can reuse Codex auth.
GEWE_SKILL_ASR_PROVIDER=codex-asr
GEWE_SKILL_ASR_LANGUAGE=zh
GEWE_SKILL_CODEX_ASR_URL=http://127.0.0.1:18788
# GEWE_SKILL_CODEX_ASR_API_KEY=replace-with-codex-asr-token

# Background ASR backfill. Keep the limit small so new voice messages are warmed
# continuously without turning one bad audio file into a busy retry loop.
GEWE_SKILL_ASR_BACKGROUND_ENABLED=false
GEWE_SKILL_ASR_BACKGROUND_INTERVAL_SECONDS=300
GEWE_SKILL_ASR_BACKGROUND_LIMIT=20
GEWE_SKILL_ASR_BACKGROUND_FORCE=false
