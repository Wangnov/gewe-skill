[Unit]
Description=gewe-skill identity backfill from recent chatroom events
After=network-online.target gewe-skill-memory.service
Wants=network-online.target

[Service]
Type=oneshot
User=gewe-skill
Group=gewe-skill
WorkingDirectory=/opt/gewe-skill-memory
EnvironmentFile=/opt/gewe-skill-memory/config/gewe-skill-memory.env
ExecStart=/opt/gewe-skill-memory/bin/gewe-skill --json maintenance identity-backfill --event-limit 500 --max-chatrooms 10 --max-wxids 100
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gewe-skill-memory/data
