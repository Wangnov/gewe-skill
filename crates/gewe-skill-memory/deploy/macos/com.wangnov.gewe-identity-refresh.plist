<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wangnov.gewe-identity-refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PREFIX__/bin/gewe-run</string>
		<string>--env</string>
		<string>__PREFIX__/config/gewe-skill-memory.env</string>
		<string>--timeout</string>
		<string>1800</string>
		<string>--</string>
		<string>__PREFIX__/bin/gewe-skill</string>
