<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wangnov.wechat-radar</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PREFIX__/bin/gewe-run</string>
		<string>--env</string>
		<string>__RADAR_PREFIX__/config/wechat-radar.env</string>
		<string>--timeout</string>
		<string>1200</string>
		<string>--</string>
		<string>__PYTHON__</string>
		<string>-m</string>
		<string>radar</string>
		<string>run</string>
	</array>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>__LOG_DIR__/com.wangnov.wechat-radar.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/com.wangnov.wechat-radar.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>WorkingDirectory</key>
	<string>__RADAR_PREFIX__/app</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
